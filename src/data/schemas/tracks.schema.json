{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "type": "object",
  "patternProperties":
  {
    "[a-zA-Z0-9-]+": {
      "type": "object",
      "required": ["name", "artist", "file"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "artist": {
          "type": ["string", "array"],
          "items": { "type": "string" }
        },
        "album": { "type": "string" },
        "lists": {
          "type": "array",
          "items": { "type": "string" }
        },
        "file": { "type": "string" },
        "cover": { "type": "string" },
        "plays": { "type": "integer", "default": 0 }
      }
    }
  }
}
